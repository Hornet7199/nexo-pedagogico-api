# Copie para .env (lido automaticamente ao rodar da raiz do projeto).

# Segredo do JWT. PRECISA ser o mesmo valor do usuario-api, que é quem emite o token: é o
# que faz o token dele valer aqui. Gere com: openssl rand -base64 48
NEXO_JWT_SECRET=

# Banco (mesmos valores do docker-compose.yml). É um banco PRÓPRIO, separado do usuario-api.
# A porta 5437 é a que o compose publica no host (DB_HOST_PORT); só vale para rodar a API
# fora do Docker com ./mvnw spring-boot:run.
DB_URL=jdbc:postgresql://localhost:5437/pedagogico_db
DB_USER=nexo_admin
DB_PASSWORD=

# Dados pedagógicos de exemplo (turmas, notas, frequência…). Só em desenvolvimento. Os ids de
# aluno e professor batem com o seed do usuario-api: ligue os dois seeds juntos.
NEXO_SEED_ENABLED=true

CORS_ALLOWED_ORIGINS=http://localhost:4200
